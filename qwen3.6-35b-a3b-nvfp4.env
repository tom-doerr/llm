# Immutable staging inputs for the Spark 2 NVFP4 candidate.
NVFP4_SOURCE_REPO=https://github.com/r0b0tlab/qwen36-35b-a3b-nvfp4-sm121-vllm.git
NVFP4_SOURCE_COMMIT=106fb53372c260e719c97d5b59e48142792783c7
NVFP4_BASE_IMAGE=ghcr.io/r0b0tlab/vllm-v0250-cu130-sm121:v0.25.0-cu130-sm121-arm64-702f4814-r2
NVFP4_BASE_DIGEST=sha256:2d144fafe3f330fa17fa1facf4f589eee49b75bdf539ac69d1fe002b5b5bb0a5
NVFP4_IMAGE=qwen36-35b-a3b-nvfp4-sm121-vllm:v025-pinned-106fb53

NVFP4_MODEL_ID=nvidia/Qwen3.6-35B-A3B-NVFP4
NVFP4_MODEL_REVISION=491c2f1ea524c639598bf8fa787a93fed5a6fbce
NVFP4_MODEL_HOST=/home/tom/models/llm/nvfp4/nvidia/Qwen3.6-35B-A3B-NVFP4-491c2f1

# Future direct-cutover profile. This file is not consumed by the live FP8 deployment.
# Bypass the image's stock launcher because its defaults inject MTP K=2 and
# --max-num-seqs 32; invoke the audited vLLM API module directly at cutover.
NVFP4_ENTRYPOINT=/usr/bin/python3
NVFP4_SERVER_MODULE=vllm.entrypoints.openai.api_server
NVFP4_PORT=8000
NVFP4_MAX_MODEL_LEN=262144
NVFP4_MAX_NUM_BATCHED_TOKENS=8192
NVFP4_KV_CACHE_DTYPE=fp8
NVFP4_ATTENTION_BACKEND=flashinfer
NVFP4_MOE_BACKEND=flashinfer_b12x
NVFP4_LINEAR_BACKEND=flashinfer_cutlass
NVFP4_QUANTIZATION=modelopt_mixed
NVFP4_SPECULATIVE_CONFIG=
NVFP4_LANGUAGE_MODEL_ONLY=0

# Deliberately no max-num-seqs setting and no media-count limit.
