    {
      "id": 5,
      "title": "NAS CPU / memory",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cfagbva82okjkf"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"node-nas\",mode=\"idle\"}[2m])))",
          "legendFormat": "cpu used %",
          "refId": "A"
        },
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node-nas\"} / node_memory_MemTotal_bytes{job=\"node-nas\"})",
          "legendFormat": "mem used %",
          "refId": "B"
        }
      ]
    },
